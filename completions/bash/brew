if [[ -n ${POSIXLY_CORRECT:-} ]] || shopt -oq posix
then
  echo "Homebrew Bash completions do not work in POSIX mode" 1>&2
  return
fi

__brewcomp_words_include() {
  local element idx
  for (( idx = 1; idx < COMP_CWORD; idx++ ))
  do
    element=${COMP_WORDS[idx]}
    [[ -n ${element} && ${element} == "$1" ]] && return 0
  done
  return 1
}

__brewcomp_words() {
  local line
  local -a words
  while IFS= read -r line
  do
    IFS=$' \t' read -r -a words <<< "${line}"
    [[ ${#words[@]} -gt 0 ]] && printf '%s\n' "${words[@]}"
  done <<< "$1"
}

__brewcomp_lines() {
  local line
  while IFS= read -r line
  do
    [[ -n ${line} && ${line} == "${COMP_WORDS[COMP_CWORD]}"* ]] && COMPREPLY+=("${line}")
  done <<< "$1"
}

__brewcomp() {
  local line
  while IFS= read -r line
  do
    __brewcomp_words_include "${line}" || __brewcomp_lines "${line}"
  done < <(__brewcomp_words "$1")
}

# Like __brewcomp(), but each line may be "flag<TAB>conflicting_flag1,conflicting_flag2"
# to also exclude a flag once any of its listed conflicts has already been given.
__brewcomp_exclusive() {
  local line word conflicts conflict matched
  while IFS= read -r line
  do
    [[ -z ${line} ]] && continue
    word=${line%%$'\t'*}
    conflicts=""
    [[ ${word} != "${line}" ]] && conflicts=${line#*$'\t'}
    __brewcomp_words_include "${word}" && continue
    matched=false
    if [[ -n ${conflicts} ]]
    then
      local -a conflict_list
      IFS=',' read -r -a conflict_list <<< "${conflicts}"
      for conflict in "${conflict_list[@]}"
      do
        __brewcomp_words_include "${conflict}" && matched=true && break
      done
    fi
    [[ ${matched} == true ]] || __brewcomp_lines "${word}"
  done <<< "$1"
}

# Don't use __brewcomp() in any of the __brew_complete_foo functions, as
# it is too slow and is not worth it just for duplicate elimination.
__brew_complete_formulae() {
  __brewcomp_lines "$(HOMEBREW_COMPLETION=1 brew formulae)"
}

__brew_complete_casks() {
  __brewcomp_lines "$(HOMEBREW_COMPLETION=1 brew casks)"
}

__brew_complete_installed_formulae() {
